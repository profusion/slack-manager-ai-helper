{
  "workspaceUrl": "https://example.slack.com",
  "storage": {
    "slacrawlDatabasePath": "~/.slacrawl/slacrawl.db"
  },
  "prompts": [
    "@DEFAULT_BASE_INSTRUCTIONS@",
    "@DEFAULT_BASE_PROMPT@",
    "plan-reviews/INSTRUCTIONS.md"
  ],
  "model": {
    "provider": "openai-compatible",
    "model": "gpt-5.4-mini",
    "maxOutputTokens": 4000,
    "failOnInvalidOutput": true
  },
  "channels": [
    {
      "id": "C_PLANNING",
      "name": "team-planning",
      "kind": "channel",
      "users": [
        {
          "id": "U_ALICE",
          "name": "Alice",
          "role": "engineer"
        },
        {
          "id": "U_BOB",
          "name": "Bob",
          "role": "engineer"
        }
      ],
      "matchers": [
        {
          "id": "daily_planning",
          "type": "regex",
          "pattern": "\\bplan[a-z]*\\b",
          "flags": "iu"
        },
        {
          "id": "planning_fts_like",
          "type": "text",
          "terms": ["plan", "planning", "review"]
        }
      ]
    }
  ],
  "globalMatchers": [],
  "context": {
    "includeRealThread": true,
    "nearbyMessagesBeforeMinutes": 5,
    "nearbyMessagesAfterMinutes": 60,
    "maxMessages": 100,
    "syntheticThreads": {
      "enabled": true,
      "candidateWindowMinutes": 60,
      "thresholds": {
        "unrelatedBelow": 0.6,
        "ambiguousFrom": 0.6,
        "ambiguousBelow": 0.72,
        "relatedFrom": 0.72
      },
      "scoring": {
        "semanticSimilarityWeight": 0.55,
        "lexicalOverlapWeight": 0.2,
        "sameAuthorOrMentionWeight": 0.1,
        "temporalProximityWeight": 0.1,
        "channelTopicMatchWeight": 0.05
      },
      "heuristics": {
        "keywords": ["done", "review", "update", "blocked", "plan", "planning"],
        "messageHasReplyMarkers": [
          "about that",
          "regarding that",
          "answering",
          "yes",
          "no",
          "done",
          "I will check",
          "I checked",
          "blocked"
        ]
      },
      "embeddings": {
        "enabled": true,
        "provider": "ollama",
        "model": "nomic-embed-text",
        "cache": true
      },
      "classifier": {
        "enabled": true,
        "useForRanges": ["ambiguous"],
        "provider": "ollama",
        "model": "qwen3:0.6b",
        "timeoutMs": 120000,
        "maxInputMessages": 8
      }
    }
  }
}
