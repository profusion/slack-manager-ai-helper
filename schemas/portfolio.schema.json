{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/barbieri/slack-manager-ai-helper/schemas/portfolio.schema.json",
  "description": "Generic portfolio automation manifest. Analyses define reusable Slack manager workflows, their targets, schedules, rollups, maintenance tasks, report publishing, and notification defaults.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "analyses"],
  "properties": {
    "schemaVersion": {
      "description": "Portfolio manifest schema version.",
      "const": 1
    },
    "timezone": {
      "description": "IANA timezone used by portfolio scheduling and template context.",
      "type": "string",
      "minLength": 1
    },
    "defaults": {
      "description": "Top-level defaults inherited by analyses, runs, rollups, maintenance tasks, and targets.",
      "$ref": "#/$defs/defaults"
    },
    "analyses": {
      "description": "Reusable analysis workflows such as plan reviews or SWOT monitoring.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/analysis"
      }
    },
    "coach": {
      "description": "Portfolio plan-coach settings. Enabled defaults to false; prompt and model are required when any tracked user resolves to enabled.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "$ref": "#/$defs/analysisModel"
        },
        "skipWhenReportMatches": {
          "description": "Optional regular expression checked against each tracked user's dated report excerpt before calling the coach model. A match skips coaching for that user and date.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "analysisConfig": {
          "$ref": "#/$defs/object"
        },
        "matchers": {
          "$ref": "#/$defs/commonMatchers"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "reports": {
          "$ref": "#/$defs/reports"
        },
        "runAndNotifyConfig": {
          "$ref": "#/$defs/runAndNotifyConfig"
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "targets"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "defaults": {
          "$ref": "#/$defs/defaults"
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
          }
        },
        "rollups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rollup"
          }
        },
        "maintenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/maintenance"
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/target"
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["active", "paused", "archived"]
        },
        "startedOn": {
          "$ref": "#/$defs/date"
        },
        "endedOn": {
          "$ref": "#/$defs/date"
        },
        "archiveReason": {
          "type": "string",
          "minLength": 1
        },
        "analysisConfig": {
          "$ref": "#/$defs/object"
        },
        "runAndNotifyConfig": {
          "$ref": "#/$defs/runAndNotifyConfig"
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/targetRunOverride"
          }
        },
        "coach": {
          "description": "Plan-coach overrides for tracked users on this target. A boolean overrides enabled; null or omission inherits. In an object, omitted or null enabled inherits, omitted or null skipWhenReportMatches inherits the root pattern, a string overrides it, and false disables it.",
          "oneOf": [
            { "type": ["boolean", "null"] },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": ["boolean", "null"] },
                "skipWhenReportMatches": {
                  "oneOf": [
                    { "type": "string", "minLength": 1 },
                    { "const": false },
                    { "type": "null" }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "commonMatchers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pre": {
          "description": "Matchers prepended to every materialized channel matcher list.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/object"
          }
        },
        "post": {
          "description": "Matchers appended to every materialized channel matcher list.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/object"
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schedule", "window"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "schedule": {
          "$ref": "#/$defs/schedule"
        },
        "window": {
          "$ref": "#/$defs/window"
        },
        "analysisConfig": {
          "$ref": "#/$defs/object"
        },
        "runAndNotifyConfig": {
          "$ref": "#/$defs/runAndNotifyConfig"
        }
      }
    },
    "rollup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schedule", "window", "prompt"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "schedule": {
          "$ref": "#/$defs/schedule"
        },
        "window": {
          "$ref": "#/$defs/window"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "runAndNotifyConfig": {
          "$ref": "#/$defs/runAndNotifyConfig"
        }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "schedule"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "kind": {
          "enum": ["compact-state"]
        },
        "schedule": {
          "$ref": "#/$defs/schedule"
        },
        "keepRuns": {
          "type": "integer",
          "minimum": 1
        },
        "backup": {
          "type": "boolean"
        }
      }
    },
    "targetRunOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId"],
      "properties": {
        "runId": {
          "$ref": "#/$defs/slug"
        },
        "analysisConfig": {
          "$ref": "#/$defs/object"
        },
        "runAndNotifyConfig": {
          "$ref": "#/$defs/runAndNotifyConfig"
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["daily", "workdays", "weekdays", "every-n-workdays", "manual"]
        },
        "time": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}$"
        },
        "weekdays": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
          }
        },
        "everyWorkdays": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "enum": ["current-workday", "previous-workday", "previous-5-workdays"]
        },
        "startDate": {
          "$ref": "#/$defs/date"
        },
        "endDate": {
          "$ref": "#/$defs/date"
        }
      },
      "oneOf": [
        {
          "required": ["date"]
        },
        {
          "required": ["name"]
        },
        {
          "anyOf": [
            {
              "required": ["startDate"]
            },
            {
              "required": ["endDate"]
            }
          ]
        }
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pathTemplate": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "archiveRepoPath": {
          "type": "string",
          "minLength": 1
        },
        "baseDir": {
          "type": "string",
          "minLength": 1
        },
        "latestViews": {
          "type": "boolean"
        },
        "templates": {
          "$ref": "#/$defs/object"
        },
        "commit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "messageTemplate": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "runAndNotifyConfig": {
      "type": "object",
      "not": {
        "anyOf": [
          {
            "required": ["stdout"]
          },
          {
            "required": ["stderr"]
          }
        ]
      },
      "additionalProperties": true
    },
    "object": {
      "type": "object",
      "additionalProperties": true
    },
    "analysisModel": {
      "description": "LLM provider and generation settings used for matched-message analysis.",
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": {
          "description": "Built-in AI SDK provider id, such as openai, anthropic, google, xai, openrouter, opencode, openai-compatible, gateway, or ollama.",
          "type": "string",
          "minLength": 1
        },
        "model": {
          "description": "Provider-specific model name passed to the Vercel AI SDK provider factory.",
          "type": "string",
          "minLength": 1
        },
        "fallback": {
          "description": "Optional fallback analysis model tried after this model exhausts its retries because provider execution failed or failOnInvalidOutput rejected structured output. Fallback models use the same schema recursively.",
          "$ref": "#/$defs/analysisModel"
        },
        "retries": {
          "description": "Number of retry attempts for this model before falling back to model.fallback or failing the run. Defaults to 3, meaning the model may be called up to 4 times.",
          "type": "integer",
          "minimum": 0
        },
        "baseUrl": {
          "description": "Optional provider base URL for analysis model providers that support custom endpoints, such as openai-compatible and ollama. For Ollama, defaults to OLLAMA_URL or http://127.0.0.1:11434.",
          "type": "string",
          "minLength": 1
        },
        "temperature": {
          "description": "Optional model sampling temperature. Lower values make outputs more deterministic. Omitted automatically for known reasoning model families that do not support temperature.",
          "type": "number",
          "minimum": 0
        },
        "reasoningEffort": {
          "description": "Optional reasoning effort for providers/models that support it. Passed through as the provider-specific AI SDK reasoning effort option.",
          "type": "string",
          "enum": ["none", "minimal", "low", "medium", "high", "xhigh"]
        },
        "minReportWords": {
          "description": "Minimum number of meaningful words required in structured reportText. A meaningful word contains at least four alphabetic characters after Markdown formatting, links, URLs, code fences, and punctuation are removed. Defaults to 25.",
          "type": "integer",
          "minimum": 1
        },
        "maxOutputTokens": {
          "description": "Optional upper bound for generated output tokens.",
          "type": "integer",
          "minimum": 1
        },
        "contextWindowTokens": {
          "description": "Optional model context window size in tokens. When set, the runtime estimates the fully compiled system and prompt tokens, including schemas and previous memory, and splits model calls by local date/channel before the request would exceed this window.",
          "type": "integer",
          "minimum": 1
        },
        "timeoutMs": {
          "description": "Optional timeout in milliseconds for the analysis model call. When omitted, the provider request uses the AI SDK default behavior.",
          "type": "integer",
          "minimum": 1
        },
        "openrouter": {
          "description": "Optional OpenRouter-specific analysis model request settings. Only used when model.provider is openrouter; omitted fields are not sent to OpenRouter.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "includeReasoning": {
              "description": "When false, sends OpenRouter reasoning.exclude=true so reasoning tokens are not included in the response. When true, sends reasoning.exclude=false. When omitted, no reasoning exclude preference is sent.",
              "type": "boolean"
            },
            "order": {
              "description": "OpenRouter provider slugs to try in order, forwarded as provider.order.",
              "type": "array",
              "minItems": 1,
              "items": {
                "description": "OpenRouter provider slug.",
                "type": "string",
                "minLength": 1
              }
            },
            "allowFallbacks": {
              "description": "Whether OpenRouter may use fallback providers when the preferred provider is unavailable, forwarded as provider.allow_fallbacks.",
              "type": "boolean"
            }
          }
        },
        "failOnInvalidOutput": {
          "description": "When true, a model output that fails the prompt-declared JSON Schema is retried according to model.retries before falling back or marking the run as failed. When false, validation errors are stored without crashing.",
          "type": "boolean"
        }
      }
    }
  }
}
