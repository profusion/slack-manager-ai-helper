{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/barbieri/slack-manager-ai-helper/schemas/portfolio.schema.json",
  "description": "Generic portfolio automation manifest. Analyses define reusable Slack manager workflows, their targets, schedules, rollups, maintenance tasks, report publishing, and notification defaults.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "analyses"],
  "properties": {
    "schemaVersion": {
      "description": "Portfolio manifest schema version.",
      "const": 1
    },
    "timezone": {
      "description": "IANA timezone used by portfolio scheduling and template context.",
      "type": "string",
      "minLength": 1
    },
    "defaults": {
      "description": "Top-level defaults inherited by analyses, runs, rollups, maintenance tasks, and targets.",
      "$ref": "#/$defs/defaults"
    },
    "analyses": {
      "description": "Reusable analysis workflows such as plan reviews or SWOT monitoring.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/analysis"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "analysisConfig": {
          "$ref": "#/$defs/object"
        },
        "matchers": {
          "$ref": "#/$defs/commonMatchers"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "reports": {
          "$ref": "#/$defs/reports"
        },
        "runAndNotifyConfig": {
          "$ref": "#/$defs/runAndNotifyConfig"
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "targets"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "defaults": {
          "$ref": "#/$defs/defaults"
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
          }
        },
        "rollups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rollup"
          }
        },
        "maintenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/maintenance"
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/target"
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["active", "paused", "archived"]
        },
        "startedOn": {
          "$ref": "#/$defs/date"
        },
        "endedOn": {
          "$ref": "#/$defs/date"
        },
        "archiveReason": {
          "type": "string",
          "minLength": 1
        },
        "analysisConfig": {
          "$ref": "#/$defs/object"
        },
        "runAndNotifyConfig": {
          "$ref": "#/$defs/runAndNotifyConfig"
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/targetRunOverride"
          }
        }
      }
    },
    "commonMatchers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pre": {
          "description": "Matchers prepended to every materialized channel matcher list.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/object"
          }
        },
        "post": {
          "description": "Matchers appended to every materialized channel matcher list.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/object"
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schedule", "window"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "schedule": {
          "$ref": "#/$defs/schedule"
        },
        "window": {
          "$ref": "#/$defs/window"
        },
        "analysisConfig": {
          "$ref": "#/$defs/object"
        },
        "runAndNotifyConfig": {
          "$ref": "#/$defs/runAndNotifyConfig"
        }
      }
    },
    "rollup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schedule", "window", "prompt"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "schedule": {
          "$ref": "#/$defs/schedule"
        },
        "window": {
          "$ref": "#/$defs/window"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "runAndNotifyConfig": {
          "$ref": "#/$defs/runAndNotifyConfig"
        }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "schedule"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "kind": {
          "enum": ["compact-state"]
        },
        "schedule": {
          "$ref": "#/$defs/schedule"
        },
        "keepRuns": {
          "type": "integer",
          "minimum": 1
        },
        "backup": {
          "type": "boolean"
        }
      }
    },
    "targetRunOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId"],
      "properties": {
        "runId": {
          "$ref": "#/$defs/slug"
        },
        "analysisConfig": {
          "$ref": "#/$defs/object"
        },
        "runAndNotifyConfig": {
          "$ref": "#/$defs/runAndNotifyConfig"
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["daily", "workdays", "weekdays", "every-n-workdays", "manual"]
        },
        "time": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}$"
        },
        "weekdays": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
          }
        },
        "everyWorkdays": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "enum": ["current-workday", "previous-workday", "previous-5-workdays"]
        },
        "startDate": {
          "$ref": "#/$defs/date"
        },
        "endDate": {
          "$ref": "#/$defs/date"
        }
      },
      "oneOf": [
        {
          "required": ["date"]
        },
        {
          "required": ["name"]
        },
        {
          "anyOf": [
            {
              "required": ["startDate"]
            },
            {
              "required": ["endDate"]
            }
          ]
        }
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pathTemplate": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "archiveRepoPath": {
          "type": "string",
          "minLength": 1
        },
        "baseDir": {
          "type": "string",
          "minLength": 1
        },
        "latestViews": {
          "type": "boolean"
        },
        "templates": {
          "$ref": "#/$defs/object"
        },
        "commit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "messageTemplate": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "runAndNotifyConfig": {
      "type": "object",
      "not": {
        "anyOf": [
          {
            "required": ["stdout"]
          },
          {
            "required": ["stderr"]
          }
        ]
      },
      "additionalProperties": true
    },
    "object": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
